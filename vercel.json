{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/lesson-01", "destination": "/01_ai_intro.html" },
    { "source": "/car-damage", "destination": "/car-damage-demo/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}